{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acoustic-ms.local/schemas/figure_manifest.schema.json",
  "title": "Acoustic MS figure manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "figure_id", "title", "created_utc", "provenance",
    "style_profile", "formats", "output_stem", "source_tables", "panels"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "figure_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "campaign_manifest", "generator"],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "campaign_manifest": {"type": "string", "minLength": 1},
        "generator": {"type": "string", "minLength": 1}
      }
    },
    "style_profile": {"type": "string", "const": "diagnostic-v1"},
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["pdf", "svg", "png"]}
    },
    "output_stem": {"type": "string", "minLength": 1},
    "source_tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table_id", "level", "path", "sha256"],
        "properties": {
          "table_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "level": {"type": "string", "enum": ["derived", "plot_ready"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^(TBD|[0-9a-f]{64})$"}
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["panel_id", "label", "title", "source_table", "x", "y", "filters", "transformations"],
        "properties": {
          "panel_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "label": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "source_table": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "x": {"type": "string", "minLength": 1},
          "y": {"type": "string", "minLength": 1},
          "filters": {"type": "object"},
          "transformations": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
